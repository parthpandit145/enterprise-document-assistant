# Copy to `.env` and fill in what you need:  cp .env.example .env
# Every value below is optional — the defaults give you a working local system.

# ---------------------------------------------------------------------------
# LLM (answer synthesis)
# ---------------------------------------------------------------------------
# anthropic  -> Claude via the Anthropic Messages API   (default, needs a key)
# openai     -> OpenAI chat models                       (needs langchain-openai)
# ollama     -> fully local model via Ollama             (needs langchain-ollama)
# extractive -> no LLM at all; answers are stitched from the retrieved sentences.
#               Zero keys, zero network. Useful for testing the retrieval half
#               of the pipeline in isolation.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=4096

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Embeddings (semantic search)
# ---------------------------------------------------------------------------
# huggingface -> local sentence-transformers model (default, free, offline
#                after the first download)
# openai      -> OpenAI embeddings (needs OPENAI_API_KEY + langchain-openai)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
TOP_K=5
# "similarity" = plain nearest-neighbour. "mmr" = maximal marginal relevance,
# which trades a little relevance for more diverse chunks (better for
# "summarise the document" style questions).
SEARCH_TYPE=similarity
# Minimum cosine similarity (0..1) a chunk must reach to be shown to the LLM.
# If nothing survives, the assistant abstains instead of guessing. On the
# sample corpus a good match scores 0.4-0.7, a weak-but-real match ~0.25, and
# a genuinely off-topic question tops out below 0.10 — so 0.15 keeps recall
# while still refusing questions the documents cannot answer at all.
SCORE_THRESHOLD=0.15
MAX_CONTEXT_CHARS=12000

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
PDF_DIR=data/pdfs
PERSIST_DIR=storage/chroma
COLLECTION_NAME=enterprise_docs
